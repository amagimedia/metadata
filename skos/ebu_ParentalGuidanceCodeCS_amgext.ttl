parentalguidance:_157.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "I"@en ;
        skos:definition   "A korhatárra tekintet nélkül megtekinthető műsorokat a csatornáknak nem kell jelöléssel ellátniuk, és bármikor bemutathatók."@en ;
        skos:broader      parentalguidance:_157.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_157.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "II"@en ;
        skos:definition   "A 6 éven aluliak számára nem ajánlott műsor a megfelelőjelzéssel bármikor vetíthető, de 6 éven aluliaknak szánt műsorszámok között nem tehető közzé."@en ;
        skos:broader      parentalguidance:_157.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_157.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "III"@en ;
        skos:definition   "A 12 éven aluliak számára nem ajánlott műsorok a jelzéssel bármikor adásba kerülhetnek, kivéve a 12 éven aluliaknak szánt műsorszám között."@en ;
        skos:broader      parentalguidance:_157.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_157.1.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "IV"@en ;
        skos:definition   "A 16 éven aluliak számára nem ajánlott műsorok csak 21 óra és hajnali 5 óra között vetíthetők."@en ;
        skos:broader      parentalguidance:_157.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_157.1.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "V"@en ;
        skos:definition   "A 18 éven aluliak számára nem ajánlott műsorok csak 22 óra és hajnali 5 óra között vetíthetők."@en ;
        skos:broader      parentalguidance:_157.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

