        skos:example      "" .

parentalguidance:_47.2.16
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "Mild Violence"@en ;
        skos:definition   "Mild scenes depicting characters in unsafe and/or violent\n         situations" ;
        skos:broader      parentalguidance:_47.2 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
