parentalguidance:_29.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "GA"@en ;
        skos:altLabel     "General Audience"@en ;
        skos:prefLabel    "Lucht Féachana Ginearálta"@ga ;
        skos:definition   "A programme that would be acceptable to all ages and\n         tastes."@en ;
        skos:broader      parentalguidance:_29 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
