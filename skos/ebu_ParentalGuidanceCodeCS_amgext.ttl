parentalguidance:_47.2.9
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "Edutainment"@en ;
        skos:definition   "Content of product provides user with specific skills development\n         or reinforcement learning within an entertainment setting. Skill development is an integral\n         part of product" ;
        skos:broader      parentalguidance:_47.2 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

