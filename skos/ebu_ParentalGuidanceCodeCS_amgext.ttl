parentalguidance:_117.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "Rating"@en ;
        skos:broader      parentalguidance:_117 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:narrower     parentalguidance:_117.1.1 ;
        skos:narrower     parentalguidance:_117.1.2 ;
        skos:narrower     parentalguidance:_117.1.3 ;
        skos:narrower     parentalguidance:_117.1.4 ;
