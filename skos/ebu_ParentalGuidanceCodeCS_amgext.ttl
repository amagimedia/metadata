parentalguidance:_35.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@en ;
        skos:definition   "For all audiences containing no content requiring parent\n         supervision" ;
        skos:definition   "Para todo público. Todos los programas bajo esta clasificación\n         son aptos para todo público y no deben contener elementos inadecuados para que los niños\n         los vean sin la supervisión de personas adultas."@es ;
        skos:broader      parentalguidance:_35.1 ;
