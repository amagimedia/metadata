parentalguidance:_118.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "B"@en ;
        skos:altLabel     "Language Type-B"@en ;
        skos:definition   "texts, images or sounds, in common usage, have a vile character."@en ;
        skos:broader      parentalguidance:_118.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_118.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "C"@en ;
        skos:altLabel     "Language Type-C"@en ;
        skos:definition   "texts, images or sounds, in common usage, is obscene, constituting imprecations, to describe, depict or allude without explicit educational purpose, to bodies or sexual practices or eschatological events."@en ;
        skos:broader      parentalguidance:_118.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
