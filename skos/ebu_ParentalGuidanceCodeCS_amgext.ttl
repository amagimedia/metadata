parentalguidance:_42.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M/4"@en ;
        skos:definition   "For persons of age 4 and above"@en ;
        skos:definition   "os espectáculos de curta duração e de fácil compreensão que não\n         provoquem reacções de pavor e que não colidam com a fantasia e com o sentido lúdico deste\n         nível etário."@pt ;
        skos:broader      parentalguidance:_42 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_42.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M/6"@en ;
        skos:definition   "For persons of age 6 and above"@en ;
        skos:definition   "os espectáculos que, pela sua temática ou extensão, não sejam\n         abrangidos pelos critérios fixados para os níveis etários superiores."@pt ;
        skos:broader      parentalguidance:_42 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_42.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M/12"@en ;
        skos:definition   "For persons of age 12 and above"@en ;
        skos:definition   "os espectáculos que, pela sua extensão e complexidade, possam\n         provocar nos espectadores de nível etário inferior fadiga excessiva e ou traumatismo\n         psíquico."@pt ;
        skos:broader      parentalguidance:_42 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_42.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M/16"@en ;
        skos:definition   "For persons of age 16 and above"@en ;
        skos:definition   "os espectáculos que explorem, em termos excessivos, aspectos da\n         sexualidade e da violência física e psíquica."@pt ;
        skos:broader      parentalguidance:_42 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_42.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M/18"@en ;
        skos:definition   "For persons of age 18 and above"@en ;
        skos:definition   "os espectáculos pornográficos e os que explorem formas\n         patológicas de violência física e psíquica."@pt ;
        skos:broader      parentalguidance:_42 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
