parentalguidance:_118.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@en ;
        skos:altLabel     "Language Type-A"@en ;
        skos:definition   "texts, images or sounds commonly used, which can be seen by children and adolescents without requiring guidance from mothers, fathers, representatives or guardians, and not classified in types \"B\" and \" C \"."@en ;
        skos:broader      parentalguidance:_118.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
