parentalguidance:_29.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "CH"@en ;
        skos:altLabel     "Children"@en ;
        skos:prefLabel    "Páistí"@ga ;
        skos:definition   "a programme aimed specifically at children ages 5–10. May\n         contain mild cartoon or fantasy violence."@en ;
        skos:broader      parentalguidance:_29 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_29.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "YA"@en ;
        skos:altLabel     "Young Adult"@en ;
        skos:prefLabel    "Ógra"@ga ;
        skos:definition   "a programme aimed at an adolescent audience. That is to say it\n         would not be of great interest to an adult. However, it might deal with issues which affect\n         the teenage and late preteen audience, e.g. relationships, sexual activity, sexuality, soft\n         drugs. Parents and guardians could expect that \"YA\" programmes might contain such material\n         and may choose to limit their children's access."@en ;
        skos:broader      parentalguidance:_29 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_29.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "PS"@en ;
        skos:altLabel     "Parental Supervision"@en ;
        skos:prefLabel    "Treoir Tuismitheora"@ga ;
        skos:definition   "a programme aimed at a mature audience (i.e. It might deal with\n         adult themes, be moderately violent, frightening or contain an occasional swear word.) and\n         the classification label invites parents or guardians to consider restricting children's\n         access."@en ;
        skos:broader      parentalguidance:_29 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_29.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "MA"@en ;
        skos:altLabel     "Mature Audience"@en ;
        skos:prefLabel    "Lucht Féachana Lánfhásta Amháin"@ga ;
        skos:definition   "a typical \"post-watershed\" program which might contain scenes\n         of strong sexual activity and heavy violence, or the dialogue might be\n         profane."@en ;
        skos:broader      parentalguidance:_29 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

