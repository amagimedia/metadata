parentalguidance:_6.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@po ;
        skos:prefLabel    "A"@en ;
        skos:definition   "When the film confirms the ideals of humanism or popularizes\n         the national and world cultures or contributes to upbringing children"@en ;
        skos:broader      parentalguidance:_6 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
