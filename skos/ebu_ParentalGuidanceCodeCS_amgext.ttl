parentalguidance:_3.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "G"@en ;
        skos:altLabel    "General"@en ;
        skos:definition   "G classified films and computer games are for general viewing.\n         Many of the films and computer games contain content that would be of no interest to\n         children. The impact of the content is very mild."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel     "PG"@en ;
        skos:altLabel    "Parental Guidance"@en ;
        skos:definition   "PG classified films and computer games may contain material\n         that needs to be explained to children therefore parental guidance is recommended. The\n         impact of the content is mild."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M"@en ;
        skos:altLabel     "Mature"@en ;
        skos:definition   "The M category is recommended for mature audiences. A mature\n         perspective is required to view this material. The impact of the content is\n         moderate."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "MA15+"@en ;
        skos:definition   "The MA 15+ category is a legally restricted category. The\n         impact of the content is strong. A person under the age of 15 years must be accompanied by\n         a parent or adult guardian if viewing or buying a film or computer game classified MA\n         15+."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "R18+"@en ;
        skos:definition   "R 18+ classified films are legally restricted to persons 18\n         years and over because of the high impact content. Some material in this classification may\n         be offensive to some sections of the adult community. "@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.6
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "X18+"@en ;
        skos:altLabel     "Restricted to 18 and over"@en ;
        skos:definition   "The X 18+ classification only applies to films that contain\n         sexually explicit material between consenting adults. It is restricted to persons aged 18\n         years and over and can only be sold or hired legally in the ACT and the Northern Territory.\n         The possession and supply of X 18+ films is prohibited in prescribed areas of the Northern\n         Territory."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_3.7
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "CTC"@en ;
        skos:altLabel     "Check the Classification"@en ;
        skos:definition   "Advertising for an unclassified film or computer game. Check the classification closer to release."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-13" ;
        skos:example      "" .

parentalguidance:_3.8
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "RC"@en ;
        skos:altLabel     "Refused Classification"@en ;
        skos:definition   "Cannot be sold, hired, advertised or legally imported in Australia."@en ;
        skos:broader      parentalguidance:_3 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-13" ;
        skos:example      "" .

parentalguidance:_3.9
