parentalguidance:_117.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@en ;
        skos:altLabel     "Health Type-A"@en ;
        skos:definition   "texts, images or sounds used for the dissemination of information, opinion or knowledge about prevention, treatment and elimination of alcohol, snuff, narcotic or psychotropic substances, as well as practice games compulsive gambling stake and and other addictive behaviors that can be seen by children and adolescents without requiring guidance from mothers, fathers, representatives or guardians."@en ;
        skos:broader      parentalguidance:_117.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_117.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "B"@en ;
        skos:altLabel     "Health Type-B"@en ;
        skos:definition   "texts, images or sounds used for the dissemination of information, opinion or knowledge about prevention, treatment and elimination of alcohol, snuff, narcotic or psychotropic substances, as well as practice games compulsive gambling stake and and other addictive behaviors, which if witnessed by children and adolescents require the guidance of their mothers, fathers, representatives or guardians."@en ;
        skos:broader      parentalguidance:_117.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_117.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "C"@en ;
        skos:altLabel     "Health Type-C"@en ;
        skos:definition   "texts, images or sounds in programs and promotions that refers directly or indirectly: Moderate alcohol consumption or snuff, without explicitly express their harmful effects are intended to eradicate or addictive behaviors that produce, consumer excessive alcohol or snuff, in which are explicitly expressed their harmful effects; into practice games compulsive gambling stake and in which are explicitly expressed its harmful effects, or consumption of narcotic or psychotropic substances, where explicitly stated their harmful effects."@en ;
        skos:broader      parentalguidance:_117.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_117.1.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "D"@en ;
        skos:altLabel     "Health Type-D"@en ;
        skos:definition   "texts, images or sounds in programs and promotions that directly or indirectly relate to excessive consumption of alcohol or snuff, in which is not expressed explicitly their adverse health effects; practice relating to compulsive stake games and random, which is not expressed explicitly their adverse health effects; associate the consumption of alcohol or snuff-advantaged economic position in the social or in the exercise of sexuality, associate the compulsive practice games and gambling stake, with advantages in the economic position in the social or in the exercise of sexuality associated the consumption of alcohol or snuff with improved physical and psychological performance, presented in a negative way sobriety or abstinence from alcohol and snuff, refer to the consumption of narcotic or psychotropic properties which are not expressly granted its adverse health effects, associated with the consumption of narcotic or psychotropic substances advantaged economic position, in social or in the exercise of sexuality associated consumption narcotic or psychotropic substances with improved physical and psychological performance, or negatively submit withdrawal narcotics or psychotropic substances."@en ;
        skos:broader      parentalguidance:_117.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

