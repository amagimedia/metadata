        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "12A"@en ;
        skos:definition   "Films classified in this category are considered to be suitable\n         for those of twelve and upwards. They may also be seen by younger children provided a\n         parent or adult guardian accompanies them."@en ;
        skos:broader      parentalguidance:_28 ;
