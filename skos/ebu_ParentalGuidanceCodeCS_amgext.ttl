parentalguidance:_47.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "EC"@en ;
        skos:definition   "Titles rated EC (Early Childhood) have content that may be\n         suitable for ages 3 and older. Contains no material that parents would find\n         inappropriate" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "E"@en ;
        skos:definition   "Titles rated E (Everyone) have content that may be suitable for\n         ages 6 and older. Titles in this category may contain minimal cartoon, fantasy or mild\n         violence and/or infrequent use of mild language" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "E10+"@en ;
        skos:definition   "Titles rated E10+ (Everyone 10 and older) have content that may\n         be suitable for ages 10 and older. Titles in this category may contain more cartoon,\n         fantasy or mild violence, mild language and/or minimal suggestive themes" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "T"@en ;
        skos:definition   "Titles rated T (Teen) have content that may be suitable for ages\n         13 and older. Titles in this category may contain violence, suggestive themes, crude\n         humour, minimal blood, simulated gambling, and/or infrequent use of strong\n         language" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "M"@en ;
        skos:definition   "Titles rated M (Mature) have content that may be suitable for\n         persons ages 17 and older. Titles in this category may contain intense violence, blood and\n         gore, sexual content and/or strong language" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.6
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "AO"@en ;
        skos:definition   "Titles rated AO (Adults Only) have content that should only be\n         played by persons 18 years and older. Titles in this category may include prolonged scenes\n         of intense violence and/or graphic sexual content and nudity" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.7
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "RP"@en ;
        skos:definition   "Titles listed as RP (Rating Pending) have been submitted to the\n         ESRB and are awaiting final rating. (This symbol appears only in advertising prior to a\n         game's release)" ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_47.1.8
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "RP17"@en ;
        skos:definition   "Not yet assigned a final ESRB rating but anticipated to be rated Mature 17+. Appears only in advertising, marketing, and promotional materials related to a physical (e.g., boxed) video game that is expected to carry an ESRB rating, and should be replaced by a game’s rating once it has been assigned."@en ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_47.1.9
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "C"@en ;
        skos:definition   "Content is intended for young children."@en ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_47.1.10
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "10-plus"@en ;
        skos:definition   "Content is generally suitable for ages 10 and up. May contain more cartoon, fantasy or mild violence, mild language and/or minimal suggestive themes."@en ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_47.1.11
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@en ;
        skos:definition   "Content suitable only for adults ages 18 and up. May include prolonged scenes of intense violence, graphic sexual content and/or gambling with real currency."@en ;
        skos:broader      parentalguidance:_47.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
