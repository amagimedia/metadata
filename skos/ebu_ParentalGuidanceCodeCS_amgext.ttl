        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "VI"@en ;
        skos:definition   "Az ebbe a kategóriába tartozó műsorok olyan szélsőségesen erőszakos jeleneteket mutatnak be, ami miatt nem kerülhetnek adásba."@en ;
        skos:broader      parentalguidance:_157.1 ;
