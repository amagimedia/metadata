parentalguidance:_177.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "G"@en ;
        skos:definition   "The film is for the general public. It is suitable for all ages of viewers, and the content is within a positive framework and free from the effects of violence and intimidation"@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_177.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "PG"@en ;
        skos:definition   "is recommended that adults be present with children under 12 years of age, and the content in general is safe for those under 12 years old, but some scenes may not be suitable for them, so adults should evaluate whether the film is suitable for them or not"@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_177.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "PG12"@en ;
        skos:definition   "Required the presence of adults with less than 12 years of age, where topics include imaging mature, treated conservatively and suitable for those who are at the age of 12 and above."@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_177.1.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "R12"@en ;
        skos:definition   "Viewers under the age of 12 are prohibited from entering, as the film includes mature topics, which are preserved in a manner that is appropriate and appropriate for those of this age and over."@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_177.1.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "R15"@en ;
        skos:definition   "Viewers under the age of 15 are not allowed in, as the film includes mature topics, which are preserved in a manner that is appropriate and appropriate for those of this age and over."@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

parentalguidance:_177.1.6
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "R18"@en ;
        skos:definition   "Viewers under the age of 18 are not allowed in. The film contains relatively mature topics, usually including scenes of terror or violence."@en ;
        skos:broader      parentalguidance:_177.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-25" ;
        skos:example      "" .

