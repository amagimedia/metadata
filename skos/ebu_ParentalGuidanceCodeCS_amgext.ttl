        skos:example      "" .

parentalguidance:_6.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "B"@en ;
        skos:definition   "All ages - When the film is in no way contrary to the universal\n         rules of morality in this country, has no restrictive recommendations from the Committee\n         and does not fall in rating A"@en ;
        skos:broader      parentalguidance:_6 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_6.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "C"@en ;
        skos:definition   "For 12 and over - When the film contains certain erotic scenes\n         or scenes with drinking, taking drugs or stimulants or a few scenes of\n         violence"@en ;
        skos:broader      parentalguidance:_6 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "" ;
        skos:example      "" .

parentalguidance:_6.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "D"@po ;
        skos:prefLabel    "D"@en ;
        skos:definition   "For 16 and over - When the film contains quite a number of\n         erotic scenes or scenes with drinking, taking drugs or stimulants or a considerable number\n         of scenes showing violence"@en ;
        skos:broader      parentalguidance:_6 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
