parentalguidance:_27.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "PG"@en ;
        skos:definition   "General viewing but some scenes may be unsuitable for young\n         children"@en ;
        skos:broader      parentalguidance:_27 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
