parentalguidance:_120.1.1
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "A"@en ;
        skos:altLabel     "Violence Type-A"@en ;
        skos:definition   "texts, images or sounds used for the prevention or eradication of violence, which can be seen by children and adolescents without requiring guidance from mothers, fathers, representatives or guardians, provided they do not present the violent act or its consequences in detail or explicitly."@en ;
        skos:broader      parentalguidance:_120.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_120.1.2
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "B"@en ;
        skos:altLabel     "Violence Type-B"@en ;
        skos:definition   "texts, images or sounds that present dramatized violence or its consequences not explicitly."@en ;
        skos:broader      parentalguidance:_120.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_120.1.3
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "C"@en ;
        skos:altLabel     "Violence Type-C"@en ;
        skos:definition   "Texts, graphic images or descriptions used for the prevention or eradication of violence, which if received by children or teenagers, need the guidance of their mothers, fathers, representatives or guardians, provided that they present images or detailed or explicit graphic descriptions of violent act or its consequences."@en ;
        skos:broader      parentalguidance:_120.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_120.1.4
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "D"@en ;
        skos:altLabel     "Violence Type-D"@en ;
        skos:definition   "texts, images or graphic descriptions or actual violence presenting their consequences, not explicitly, or dramatized violence or its consequences and not explicitly detailed."@en ;
        skos:broader      parentalguidance:_120.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

parentalguidance:_120.1.5
        rdf:type          ebucore:TargetAudience ;
        skos:prefLabel    "E"@en ;
        skos:altLabel     "Violence Type-E"@en ;
        skos:definition   "texts, images or graphic descriptions that present real or dramatized violence or its consequences in an explicit and detailed, physical, psychological or verbal between people within a family with children and adolescents or against women; sexual violence, violence as a central theme or resource repeated impact, or to present, promote, justify or incite suicide or hurt your own personal integrity or personal health."@en ;
        skos:broader      parentalguidance:_120.1 ;
        skos:inScheme     <http://www.ebu.ch/metadata/ontologies/skos/ebu_ParentalGuidanceCodeCS> ;
        skos:changeNote   "" ;
        skos:historyNote  "2026-10-14" ;
        skos:example      "" .

